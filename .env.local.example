# Firebase Configuration
# Get these values from: Firebase Console > Project Settings > General > Your Apps

# Replace these with your actual Firebase config values
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Viator Partner API
# Keep this key server-side: do not add NEXT_PUBLIC_ to its name.
VIATOR_API_KEY=your-viator-api-key-here
VIATOR_SANDBOX_API_KEY=your-viator-sandbox-api-key-here
VIATOR_API_BASE_URL=https://api.sandbox.viator.com/partner
VIATOR_LOCALE=en-GB
VIATOR_CURRENCY=GBP

# PostHog analytics (EU project 267288)
# The project key is public and is included in the browser bundle.
# Set both variables in your hosting provider before building/deploying.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
